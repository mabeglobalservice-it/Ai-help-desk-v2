// Noyau MVP — voir docs/docs/08-schema-base-de-donnees.md (section 9)
// Le schema complet (12 domaines) sera etendu progressivement, module par module.

generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                    String      @id @default(uuid())
  email                 String      @unique
  passwordHash          String?     @map("password_hash")
  displayName           String      @map("display_name")
  role                  Role
  entraId               String?     @unique @map("entra_id")
  departmentId          String?     @map("department_id")
  department            Department? @relation(fields: [departmentId], references: [id])
  teamId                String?     @map("team_id")
  team                  Team?       @relation(fields: [teamId], references: [id])
  isActive              Boolean     @default(true) @map("is_active")
  // docs/06-cas-utilisation.md UC-022, docs/11-documentation-api.md §8: un
  // technicien "habilité" (au sens des docs) est un TECHNICIAN a qui
  // l'Administrateur a explicitement accorde le droit d'approuver les
  // actions sensibles du module Automation — distinct du role SUPERVISOR,
  // qui a toujours ce droit.
  canApproveAutomations Boolean     @default(false) @map("can_approve_automations")
  createdAt             DateTime    @default(now()) @map("created_at")

  ticketsAsEmployee         Ticket[]              @relation("EmployeeTickets")
  ticketsAsTechnician       Ticket[]              @relation("TechnicianTickets")
  ticketComments            TicketComment[]
  ticketAttachments         TicketAttachment[]
  notifications             Notification[]
  ticketStatusChanges       TicketStatusHistory[]
  refreshTokens             RefreshToken[]
  automationRunsRequested   AutomationRun[]       @relation("AutomationRunsRequested")
  automationRunsExecuted    AutomationRun[]       @relation("AutomationRunsExecuted")
  approvalsDecided          Approval[]
  knowledgeArticlesApproved KnowledgeArticle[]

  @@map("users")
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @map("token_hash")
  expiresAt DateTime @map("expires_at")
  revoked   Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@map("refresh_tokens")
}

enum Role {
  EMPLOYEE
  TECHNICIAN
  SUPERVISOR
  ADMIN
}

model Department {
  id        String   @id @default(uuid())
  name      String   @unique
  createdAt DateTime @default(now()) @map("created_at")

  users User[]

  @@map("departments")
}

model Team {
  id         String          @id @default(uuid())
  name       String          @unique
  categoryId String?         @map("category_id")
  category   TicketCategory? @relation(fields: [categoryId], references: [id])
  createdAt  DateTime        @default(now()) @map("created_at")

  members User[]

  @@map("teams")
}

model Location {
  id        String   @id @default(uuid())
  name      String   @unique
  address   String?
  createdAt DateTime @default(now()) @map("created_at")

  configurationItems ConfigurationItem[]

  @@map("locations")
}

model Ticket {
  id                  String             @id @default(uuid())
  reference           String             @unique
  employeeId          String             @map("employee_id")
  employee            User               @relation("EmployeeTickets", fields: [employeeId], references: [id])
  technicianId        String?            @map("technician_id")
  technician          User?              @relation("TechnicianTickets", fields: [technicianId], references: [id])
  categoryId          String             @map("category_id")
  category            TicketCategory     @relation(fields: [categoryId], references: [id])
  priorityId          String             @map("priority_id")
  priority            Priority           @relation(fields: [priorityId], references: [id])
  ciId                String?            @map("ci_id")
  ci                  ConfigurationItem? @relation(fields: [ciId], references: [id])
  title               String
  summary             String?
  status              TicketStatus       @default(NEW)
  slaDueAt            DateTime?          @map("sla_due_at")
  slaBreachNotifiedAt DateTime?          @map("sla_breach_notified_at")
  createdAt           DateTime           @default(now()) @map("created_at")
  resolvedAt          DateTime?          @map("resolved_at")
  resolutionNote      String?            @map("resolution_note")
  rating              Int?
  ratingComment       String?            @map("rating_comment")
  ratedAt             DateTime?          @map("rated_at")

  statusHistory     TicketStatusHistory[]
  comments          TicketComment[]
  attachments       TicketAttachment[]
  notifications     Notification[]
  automationRuns    AutomationRun[]
  knowledgeArticles KnowledgeArticle[]

  @@index([status, priorityId, technicianId, categoryId])
  @@map("tickets")
}

model Notification {
  id          String           @id @default(uuid())
  recipientId String           @map("recipient_id")
  recipient   User             @relation(fields: [recipientId], references: [id], onDelete: Cascade)
  type        NotificationType
  message     String
  ticketId    String?          @map("ticket_id")
  ticket      Ticket?          @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  isRead      Boolean          @default(false) @map("is_read")
  createdAt   DateTime         @default(now()) @map("created_at")

  @@index([recipientId, isRead, createdAt])
  @@map("notifications")
}

enum NotificationType {
  TICKET_ASSIGNED
  NEW_COMMENT
  STATUS_CHANGED
  SLA_BREACHED
  APPROVAL_REQUESTED
  AUTOMATION_DECIDED
}

model TicketComment {
  id        String   @id @default(uuid())
  ticketId  String   @map("ticket_id")
  ticket    Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  authorId  String   @map("author_id")
  author    User     @relation(fields: [authorId], references: [id])
  content   String
  createdAt DateTime @default(now()) @map("created_at")

  @@index([ticketId, createdAt])
  @@map("ticket_comments")
}

model TicketAttachment {
  id             String   @id @default(uuid())
  ticketId       String   @map("ticket_id")
  ticket         Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  uploadedById   String   @map("uploaded_by_id")
  uploadedBy     User     @relation(fields: [uploadedById], references: [id])
  fileName       String   @map("file_name")
  storedFileName String   @map("stored_file_name")
  mimeType       String   @map("mime_type")
  size           Int
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([ticketId, createdAt])
  @@map("ticket_attachments")
}

enum TicketStatus {
  NEW
  IN_PROGRESS
  RESOLVED
  ESCALATED
}

model TicketCategory {
  id        String   @id @default(uuid())
  name      String   @unique
  createdAt DateTime @default(now()) @map("created_at")

  tickets Ticket[]
  teams   Team[]

  @@map("ticket_categories")
}

model Priority {
  id        String   @id @default(uuid())
  name      String   @unique
  level     Int      @unique
  createdAt DateTime @default(now()) @map("created_at")

  tickets   Ticket[]
  slaPolicy SlaPolicy?

  @@map("priorities")
}

model SlaPolicy {
  id              String   @id @default(uuid())
  priorityId      String   @unique @map("priority_id")
  priority        Priority @relation(fields: [priorityId], references: [id])
  resolutionHours Int      @map("resolution_hours")
  createdAt       DateTime @default(now()) @map("created_at")

  @@map("sla_policies")
}

model TicketStatusHistory {
  id          String        @id @default(uuid())
  ticketId    String        @map("ticket_id")
  ticket      Ticket        @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  fromStatus  TicketStatus? @map("from_status")
  toStatus    TicketStatus  @map("to_status")
  // null = transition triggered automatically by the system (e.g. SLA breach
  // auto-escalation), not by a human actor
  changedById String?       @map("changed_by")
  changedBy   User?         @relation(fields: [changedById], references: [id])
  changedAt   DateTime      @default(now()) @map("changed_at")

  @@index([ticketId, changedAt])
  @@map("ticket_status_history")
}

model CiType {
  id        String   @id @default(uuid())
  name      String   @unique
  createdAt DateTime @default(now()) @map("created_at")

  configurationItems ConfigurationItem[]

  @@map("ci_types")
}

model ConfigurationItem {
  id              String        @id @default(uuid())
  ciTypeId        String        @map("ci_type_id")
  ciType          CiType        @relation(fields: [ciTypeId], references: [id])
  name            String
  inventoryNumber String        @unique @map("inventory_number")
  serialNumber    String?       @map("serial_number")
  manufacturerId  String?       @map("manufacturer_id")
  manufacturer    Manufacturer? @relation(fields: [manufacturerId], references: [id])
  modelId         String?       @map("model_id")
  model           Model?        @relation(fields: [modelId], references: [id])
  warrantyId      String?       @unique @map("warranty_id")
  warranty        Warranty?     @relation(fields: [warrantyId], references: [id], onDelete: SetNull)
  locationId      String?       @map("location_id")
  location        Location?     @relation(fields: [locationId], references: [id])
  criticality     Criticality   @default(MEDIUM)
  status          CiStatus      @default(ACTIVE)
  createdAt       DateTime      @default(now()) @map("created_at")

  relationshipsAsParent CiRelationship[] @relation("ParentCi")
  relationshipsAsChild  CiRelationship[] @relation("ChildCi")
  tickets               Ticket[]
  automationRuns        AutomationRun[]

  @@map("configuration_items")
}

// docs/08-schema-base-de-donnees.md §4.3 : fabricant et modèle d'un CI,
// normalisés pour éviter la duplication (ex. "Dell" saisi une seule fois).
model Manufacturer {
  id        String   @id @default(uuid())
  name      String   @unique
  createdAt DateTime @default(now()) @map("created_at")

  models             Model[]
  configurationItems ConfigurationItem[]

  @@map("manufacturers")
}

model Model {
  id             String       @id @default(uuid())
  name           String
  manufacturerId String       @map("manufacturer_id")
  manufacturer   Manufacturer @relation(fields: [manufacturerId], references: [id])
  createdAt      DateTime     @default(now()) @map("created_at")

  configurationItems ConfigurationItem[]

  @@unique([manufacturerId, name])
  @@map("models")
}

// US-24 : garantie d'un CI, consultée par le technicien avant de decider
// reparer vs remplacer. Relation 1-1 avec le CI (warrantyId est @unique
// cote ConfigurationItem) — onDelete: SetNull pour permettre de retirer
// une garantie sans devoir d'abord détacher le CI.
model Warranty {
  id              String   @id @default(uuid())
  provider        String
  startDate       DateTime @map("start_date")
  endDate         DateTime @map("end_date")
  referenceNumber String?  @map("reference_number")
  notes           String?
  createdAt       DateTime @default(now()) @map("created_at")

  configurationItem ConfigurationItem?

  @@map("warranties")
}

enum Criticality {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum CiStatus {
  ACTIVE
  IN_REPAIR
  RETIRED
}

model CiRelationship {
  id               String            @id @default(uuid())
  parentCiId       String            @map("parent_ci_id")
  parent           ConfigurationItem @relation("ParentCi", fields: [parentCiId], references: [id])
  childCiId        String            @map("child_ci_id")
  child            ConfigurationItem @relation("ChildCi", fields: [childCiId], references: [id])
  relationshipType RelationshipType  @map("relationship_type")

  @@map("ci_relationships")
}

enum RelationshipType {
  DEPENDS_ON
  HOSTS
  CONNECTS_TO
  RUNS_ON
}

model AuditLog {
  id          String    @id @default(uuid())
  actorId     String?   @map("actor_id")
  actorType   ActorType @map("actor_type")
  action      String
  targetType  String    @map("target_type")
  targetId    String    @map("target_id")
  ipAddress   String?   @map("ip_address")
  beforeState Json?     @map("before_state")
  afterState  Json?     @map("after_state")
  reason      String?
  createdAt   DateTime  @default(now()) @map("created_at")

  @@index([actorId, targetType, targetId, createdAt])
  @@map("audit_logs")
}

enum ActorType {
  USER
  AI_AGENT
  SYSTEM
}

// docs/08-schema-base-de-donnees.md §4.6, docs/09-architecture-agents-ia.md
// §3.5 (Agent Automation), docs/06-cas-utilisation.md RM-01/RM-02/RM-03,
// UC-014, UC-022. La distinction sensible/non-sensible n'est jamais laissee
// a la discretion d'un modele de langage : elle vient de Script.isSensitive,
// modifiable uniquement par un Administrateur.
model Script {
  id          String         @id @default(uuid())
  name        String
  language    ScriptLanguage
  content     String
  isSensitive Boolean        @default(true) @map("is_sensitive")
  createdAt   DateTime       @default(now()) @map("created_at")

  automationRuns AutomationRun[]

  @@map("scripts")
}

enum ScriptLanguage {
  POWERSHELL
  CMD
  BASH
  PYTHON
}

model AutomationRun {
  id            String              @id @default(uuid())
  scriptId      String              @map("script_id")
  script        Script              @relation(fields: [scriptId], references: [id])
  ticketId      String?             @map("ticket_id")
  ticket        Ticket?             @relation(fields: [ticketId], references: [id])
  ciId          String?             @map("ci_id")
  ci            ConfigurationItem?  @relation(fields: [ciId], references: [id])
  requestedById String              @map("requested_by_id")
  requestedBy   User                @relation("AutomationRunsRequested", fields: [requestedById], references: [id])
  // NULL si l'execution a ete automatique (script non sensible, aucune
  // approbation humaine) ; sinon l'identite de l'approbateur dont la
  // decision a declenche l'execution.
  executedById  String?             @map("executed_by_id")
  executedBy    User?               @relation("AutomationRunsExecuted", fields: [executedById], references: [id])
  justification String
  status        AutomationRunStatus @default(PENDING_APPROVAL)
  startedAt     DateTime?           @map("started_at")
  finishedAt    DateTime?           @map("finished_at")
  outputLog     String?             @map("output_log")
  createdAt     DateTime            @default(now()) @map("created_at")

  approval Approval?

  @@index([status, requestedById])
  @@map("automation_runs")
}

// REJECTED n'est pas dans la liste du doc 08 (pending_approval, running,
// success, failed) mais est necessaire pour representer l'issue terminale
// d'un rejet (UC-022, variante) sans quoi le run resterait indefiniment
// bloque a PENDING_APPROVAL.
enum AutomationRunStatus {
  PENDING_APPROVAL
  RUNNING
  SUCCESS
  FAILED
  REJECTED
}

model Approval {
  id              String         @id @default(uuid())
  automationRunId String         @unique @map("automation_run_id")
  automationRun   AutomationRun  @relation(fields: [automationRunId], references: [id])
  approvedById    String?        @map("approved_by")
  approvedBy      User?          @relation(fields: [approvedById], references: [id])
  status          ApprovalStatus @default(PENDING)
  decidedAt       DateTime?      @map("decided_at")
  createdAt       DateTime       @default(now()) @map("created_at")

  @@map("approvals")
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

// docs/10-architecture-rag.md §11 "Apprentissage continu", docs/09
// §3.4/§10 (Agent Documentation), docs/11-documentation-api.md §7. Un
// resume genere par l'IA a la resolution d'un ticket n'entre dans la base
// de connaissances (recherche via /knowledge/search) qu'apres validation
// humaine explicite — jamais automatiquement, pour eviter de propager une
// solution incomplete ou erronee dans le systeme documentaire.
model KnowledgeArticle {
  id           String                 @id @default(uuid())
  ticketId     String                 @map("ticket_id")
  ticket       Ticket                 @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  title        String
  content      String
  status       KnowledgeArticleStatus @default(PROPOSED)
  approvedById String?                @map("approved_by_id")
  approvedBy   User?                  @relation(fields: [approvedById], references: [id])
  decidedAt    DateTime?              @map("decided_at")
  createdAt    DateTime               @default(now()) @map("created_at")

  @@map("knowledge_articles")
}

enum KnowledgeArticleStatus {
  PROPOSED
  APPROVED
  REJECTED
}
