// Noyau MVP — voir docs/docs/08-schema-base-de-donnees.md (section 9)
// Le schema complet (12 domaines) sera etendu progressivement, module par module.

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String      @id @default(uuid())
  email        String      @unique
  displayName  String      @map("display_name")
  role         Role
  entraId      String?     @unique @map("entra_id")
  departmentId String?     @map("department_id")
  department   Department? @relation(fields: [departmentId], references: [id])
  isActive     Boolean     @default(true) @map("is_active")
  createdAt    DateTime    @default(now()) @map("created_at")

  ticketsAsEmployee   Ticket[] @relation("EmployeeTickets")
  ticketsAsTechnician Ticket[] @relation("TechnicianTickets")

  @@map("users")
}

enum Role {
  EMPLOYEE
  TECHNICIAN
  SUPERVISOR
  ADMIN
}

model Department {
  id        String   @id @default(uuid())
  name      String   @unique
  createdAt DateTime @default(now()) @map("created_at")

  users User[]

  @@map("departments")
}

model Ticket {
  id           String         @id @default(uuid())
  reference    String         @unique
  employeeId   String         @map("employee_id")
  employee     User           @relation("EmployeeTickets", fields: [employeeId], references: [id])
  technicianId String?        @map("technician_id")
  technician   User?          @relation("TechnicianTickets", fields: [technicianId], references: [id])
  categoryId   String         @map("category_id")
  category     TicketCategory @relation(fields: [categoryId], references: [id])
  priorityId   String         @map("priority_id")
  priority     Priority       @relation(fields: [priorityId], references: [id])
  ciId         String?        @map("ci_id")
  title        String
  summary      String?
  status       TicketStatus   @default(NEW)
  slaDueAt     DateTime?      @map("sla_due_at")
  createdAt    DateTime       @default(now()) @map("created_at")
  resolvedAt   DateTime?      @map("resolved_at")

  statusHistory TicketStatusHistory[]

  @@index([status, priorityId, technicianId, categoryId])
  @@map("tickets")
}

enum TicketStatus {
  NEW
  IN_PROGRESS
  RESOLVED
  ESCALATED
}

model TicketCategory {
  id        String   @id @default(uuid())
  name      String   @unique
  createdAt DateTime @default(now()) @map("created_at")

  tickets Ticket[]

  @@map("ticket_categories")
}

model Priority {
  id        String   @id @default(uuid())
  name      String   @unique
  level     Int      @unique
  createdAt DateTime @default(now()) @map("created_at")

  tickets Ticket[]

  @@map("priorities")
}

model TicketStatusHistory {
  id         String   @id @default(uuid())
  ticketId   String   @map("ticket_id")
  ticket     Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  fromStatus String?  @map("from_status")
  toStatus   String   @map("to_status")
  changedBy  String   @map("changed_by")
  changedAt  DateTime @default(now()) @map("changed_at")

  @@map("ticket_status_history")
}

model ConfigurationItem {
  id              String      @id @default(uuid())
  ciTypeId        String      @map("ci_type_id")
  name            String
  inventoryNumber String      @unique @map("inventory_number")
  serialNumber    String?     @map("serial_number")
  criticality     Criticality @default(MEDIUM)
  status          CiStatus    @default(ACTIVE)

  relationshipsAsParent CiRelationship[] @relation("ParentCi")
  relationshipsAsChild  CiRelationship[] @relation("ChildCi")

  @@map("configuration_items")
}

enum Criticality {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum CiStatus {
  ACTIVE
  IN_REPAIR
  RETIRED
}

model CiRelationship {
  id               String            @id @default(uuid())
  parentCiId       String            @map("parent_ci_id")
  parent           ConfigurationItem @relation("ParentCi", fields: [parentCiId], references: [id])
  childCiId        String            @map("child_ci_id")
  child            ConfigurationItem @relation("ChildCi", fields: [childCiId], references: [id])
  relationshipType RelationshipType  @map("relationship_type")

  @@map("ci_relationships")
}

enum RelationshipType {
  DEPENDS_ON
  HOSTS
  CONNECTS_TO
  RUNS_ON
}

model AuditLog {
  id          String    @id @default(uuid())
  actorId     String?   @map("actor_id")
  actorType   ActorType @map("actor_type")
  action      String
  targetType  String    @map("target_type")
  targetId    String    @map("target_id")
  ipAddress   String?   @map("ip_address")
  beforeState Json?     @map("before_state")
  afterState  Json?     @map("after_state")
  reason      String?
  createdAt   DateTime  @default(now()) @map("created_at")

  @@index([actorId, targetType, targetId, createdAt])
  @@map("audit_logs")
}

enum ActorType {
  USER
  AI_AGENT
  SYSTEM
}
