// Noyau MVP — voir docs/docs/08-schema-base-de-donnees.md (section 9)
// Le schema complet (12 domaines) sera etendu progressivement, module par module.

generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                    String      @id @default(uuid())
  email                 String      @unique
  passwordHash          String?     @map("password_hash")
  displayName           String      @map("display_name")
  role                  Role
  entraId               String?     @unique @map("entra_id")
  departmentId          String?     @map("department_id")
  department            Department? @relation(fields: [departmentId], references: [id])
  teamId                String?     @map("team_id")
  team                  Team?       @relation(fields: [teamId], references: [id])
  isActive              Boolean     @default(true) @map("is_active")
  // docs/06-cas-utilisation.md UC-022, docs/11-documentation-api.md §8: un
  // technicien "habilité" (au sens des docs) est un TECHNICIAN a qui
  // l'Administrateur a explicitement accorde le droit d'approuver les
  // actions sensibles du module Automation — distinct du role SUPERVISOR,
  // qui a toujours ce droit.
  canApproveAutomations Boolean     @default(false) @map("can_approve_automations")
  createdAt             DateTime    @default(now()) @map("created_at")

  ticketsAsEmployee         Ticket[]              @relation("EmployeeTickets")
  ticketsAsTechnician       Ticket[]              @relation("TechnicianTickets")
  ticketComments            TicketComment[]
  ticketAttachments         TicketAttachment[]
  notifications             Notification[]
  ticketStatusChanges       TicketStatusHistory[]
  refreshTokens             RefreshToken[]
  automationRunsRequested   AutomationRun[]       @relation("AutomationRunsRequested")
  automationRunsExecuted    AutomationRun[]       @relation("AutomationRunsExecuted")
  approvalsDecided          Approval[]
  knowledgeArticlesApproved KnowledgeArticle[]
  aiConversations           AiConversation[]
  aiFeedbackGiven           AiFeedback[]
  knowledgeDocumentsOwned   KnowledgeDocument[] @relation("KnowledgeDocumentOwner")
  knowledgeDocumentsUploaded KnowledgeDocument[] @relation("KnowledgeDocumentUploader")
  autoResolutionsRequested  AutoResolution[]

  @@map("users")
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @map("token_hash")
  expiresAt DateTime @map("expires_at")
  revoked   Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@map("refresh_tokens")
}

enum Role {
  EMPLOYEE
  TECHNICIAN
  SUPERVISOR
  ADMIN
}

model Department {
  id        String   @id @default(uuid())
  name      String   @unique
  createdAt DateTime @default(now()) @map("created_at")

  users User[]

  @@map("departments")
}

model Team {
  id         String          @id @default(uuid())
  name       String          @unique
  categoryId String?         @map("category_id")
  category   TicketCategory? @relation(fields: [categoryId], references: [id])
  createdAt  DateTime        @default(now()) @map("created_at")

  members User[]

  @@map("teams")
}

model Location {
  id        String   @id @default(uuid())
  name      String   @unique
  address   String?
  createdAt DateTime @default(now()) @map("created_at")

  configurationItems ConfigurationItem[]

  @@map("locations")
}

model Ticket {
  id                  String             @id @default(uuid())
  reference           String             @unique
  employeeId          String             @map("employee_id")
  employee            User               @relation("EmployeeTickets", fields: [employeeId], references: [id])
  technicianId        String?            @map("technician_id")
  technician          User?              @relation("TechnicianTickets", fields: [technicianId], references: [id])
  categoryId          String             @map("category_id")
  category            TicketCategory     @relation(fields: [categoryId], references: [id])
  priorityId          String             @map("priority_id")
  priority            Priority           @relation(fields: [priorityId], references: [id])
  ciId                String?            @map("ci_id")
  ci                  ConfigurationItem? @relation(fields: [ciId], references: [id])
  title               String
  summary             String?
  status              TicketStatus       @default(NEW)
  slaDueAt            DateTime?          @map("sla_due_at")
  slaBreachNotifiedAt DateTime?          @map("sla_breach_notified_at")
  createdAt           DateTime           @default(now()) @map("created_at")
  resolvedAt          DateTime?          @map("resolved_at")
  resolutionNote      String?            @map("resolution_note")
  rating              Int?
  ratingComment       String?            @map("rating_comment")
  ratedAt             DateTime?          @map("rated_at")

  statusHistory     TicketStatusHistory[]
  comments          TicketComment[]
  attachments       TicketAttachment[]
  notifications     Notification[]
  automationRuns    AutomationRun[]
  knowledgeArticles KnowledgeArticle[]
  aiConversations   AiConversation[]
  autoResolutionFallback AutoResolution?

  @@index([status, priorityId, technicianId, categoryId])
  @@map("tickets")
}

model Notification {
  id          String           @id @default(uuid())
  recipientId String           @map("recipient_id")
  recipient   User             @relation(fields: [recipientId], references: [id], onDelete: Cascade)
  type        NotificationType
  message     String
  ticketId    String?          @map("ticket_id")
  ticket      Ticket?          @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  isRead      Boolean          @default(false) @map("is_read")
  createdAt   DateTime         @default(now()) @map("created_at")

  @@index([recipientId, isRead, createdAt])
  @@map("notifications")
}

enum NotificationType {
  TICKET_ASSIGNED
  NEW_COMMENT
  STATUS_CHANGED
  SLA_BREACHED
  APPROVAL_REQUESTED
  AUTOMATION_DECIDED
}

model TicketComment {
  id        String   @id @default(uuid())
  ticketId  String   @map("ticket_id")
  ticket    Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  authorId  String   @map("author_id")
  author    User     @relation(fields: [authorId], references: [id])
  content   String
  createdAt DateTime @default(now()) @map("created_at")

  @@index([ticketId, createdAt])
  @@map("ticket_comments")
}

model TicketAttachment {
  id             String   @id @default(uuid())
  ticketId       String   @map("ticket_id")
  ticket         Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  uploadedById   String   @map("uploaded_by_id")
  uploadedBy     User     @relation(fields: [uploadedById], references: [id])
  fileName       String   @map("file_name")
  storedFileName String   @map("stored_file_name")
  mimeType       String   @map("mime_type")
  size           Int
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([ticketId, createdAt])
  @@map("ticket_attachments")
}

enum TicketStatus {
  NEW
  IN_PROGRESS
  RESOLVED
  ESCALATED
}

model TicketCategory {
  id        String   @id @default(uuid())
  name      String   @unique
  createdAt DateTime @default(now()) @map("created_at")

  tickets Ticket[]
  teams   Team[]

  @@map("ticket_categories")
}

model Priority {
  id        String   @id @default(uuid())
  name      String   @unique
  level     Int      @unique
  createdAt DateTime @default(now()) @map("created_at")

  tickets   Ticket[]
  slaPolicy SlaPolicy?

  @@map("priorities")
}

model SlaPolicy {
  id              String   @id @default(uuid())
  priorityId      String   @unique @map("priority_id")
  priority        Priority @relation(fields: [priorityId], references: [id])
  resolutionHours Int      @map("resolution_hours")
  createdAt       DateTime @default(now()) @map("created_at")

  @@map("sla_policies")
}

model TicketStatusHistory {
  id          String        @id @default(uuid())
  ticketId    String        @map("ticket_id")
  ticket      Ticket        @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  fromStatus  TicketStatus? @map("from_status")
  toStatus    TicketStatus  @map("to_status")
  // null = transition triggered automatically by the system (e.g. SLA breach
  // auto-escalation), not by a human actor
  changedById String?       @map("changed_by")
  changedBy   User?         @relation(fields: [changedById], references: [id])
  changedAt   DateTime      @default(now()) @map("changed_at")

  @@index([ticketId, changedAt])
  @@map("ticket_status_history")
}

model CiType {
  id        String   @id @default(uuid())
  name      String   @unique
  createdAt DateTime @default(now()) @map("created_at")

  configurationItems ConfigurationItem[]

  @@map("ci_types")
}

model ConfigurationItem {
  id              String        @id @default(uuid())
  ciTypeId        String        @map("ci_type_id")
  ciType          CiType        @relation(fields: [ciTypeId], references: [id])
  name            String
  inventoryNumber String        @unique @map("inventory_number")
  serialNumber    String?       @map("serial_number")
  manufacturerId  String?       @map("manufacturer_id")
  manufacturer    Manufacturer? @relation(fields: [manufacturerId], references: [id])
  modelId         String?       @map("model_id")
  model           Model?        @relation(fields: [modelId], references: [id])
  warrantyId      String?       @unique @map("warranty_id")
  warranty        Warranty?     @relation(fields: [warrantyId], references: [id], onDelete: SetNull)
  licenseId       String?       @unique @map("license_id")
  license         License?      @relation(fields: [licenseId], references: [id], onDelete: SetNull)
  locationId      String?       @map("location_id")
  location        Location?     @relation(fields: [locationId], references: [id])
  criticality     Criticality   @default(MEDIUM)
  status          CiStatus      @default(ACTIVE)
  createdAt       DateTime      @default(now()) @map("created_at")

  relationshipsAsParent CiRelationship[] @relation("ParentCi")
  relationshipsAsChild  CiRelationship[] @relation("ChildCi")
  tickets               Ticket[]
  automationRuns        AutomationRun[]

  @@map("configuration_items")
}

// docs/08-schema-base-de-donnees.md §4.3 : fabricant et modèle d'un CI,
// normalisés pour éviter la duplication (ex. "Dell" saisi une seule fois).
model Manufacturer {
  id        String   @id @default(uuid())
  name      String   @unique
  createdAt DateTime @default(now()) @map("created_at")

  models             Model[]
  configurationItems ConfigurationItem[]

  @@map("manufacturers")
}

model Model {
  id             String       @id @default(uuid())
  name           String
  manufacturerId String       @map("manufacturer_id")
  manufacturer   Manufacturer @relation(fields: [manufacturerId], references: [id])
  createdAt      DateTime     @default(now()) @map("created_at")

  configurationItems ConfigurationItem[]

  @@unique([manufacturerId, name])
  @@map("models")
}

// US-24 : garantie d'un CI, consultée par le technicien avant de decider
// reparer vs remplacer. Relation 1-1 avec le CI (warrantyId est @unique
// cote ConfigurationItem) — onDelete: SetNull pour permettre de retirer
// une garantie sans devoir d'abord détacher le CI.
model Warranty {
  id              String   @id @default(uuid())
  provider        String
  startDate       DateTime @map("start_date")
  endDate         DateTime @map("end_date")
  referenceNumber String?  @map("reference_number")
  notes           String?
  createdAt       DateTime @default(now()) @map("created_at")

  configurationItem ConfigurationItem?

  @@map("warranties")
}

// US-23 : "consulter les licences et leur date d'expiration, afin
// d'anticiper les renouvellements". Meme forme que Warranty (relation
// 1-1 optionnelle, onDelete: SetNull) — un CI de type "Licence" (ou tout
// autre CI rattaché a un logiciel sous licence) peut en porter une.
model License {
  id              String    @id @default(uuid())
  vendor          String
  expiresAt       DateTime  @map("expires_at")
  purchasedAt     DateTime? @map("purchased_at")
  referenceNumber String?   @map("reference_number")
  notes           String?
  createdAt       DateTime  @default(now()) @map("created_at")

  configurationItem ConfigurationItem?

  @@map("licenses")
}

enum Criticality {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum CiStatus {
  ACTIVE
  IN_REPAIR
  RETIRED
}

model CiRelationship {
  id               String            @id @default(uuid())
  parentCiId       String            @map("parent_ci_id")
  parent           ConfigurationItem @relation("ParentCi", fields: [parentCiId], references: [id])
  childCiId        String            @map("child_ci_id")
  child            ConfigurationItem @relation("ChildCi", fields: [childCiId], references: [id])
  relationshipType RelationshipType  @map("relationship_type")

  @@map("ci_relationships")
}

enum RelationshipType {
  DEPENDS_ON
  HOSTS
  CONNECTS_TO
  RUNS_ON
}

model AuditLog {
  id          String    @id @default(uuid())
  actorId     String?   @map("actor_id")
  actorType   ActorType @map("actor_type")
  action      String
  targetType  String    @map("target_type")
  targetId    String    @map("target_id")
  ipAddress   String?   @map("ip_address")
  beforeState Json?     @map("before_state")
  afterState  Json?     @map("after_state")
  reason      String?
  createdAt   DateTime  @default(now()) @map("created_at")

  @@index([actorId, targetType, targetId, createdAt])
  @@map("audit_logs")
}

enum ActorType {
  USER
  AI_AGENT
  SYSTEM
}

// docs/08-schema-base-de-donnees.md §4.6, docs/09-architecture-agents-ia.md
// §3.5 (Agent Automation), docs/06-cas-utilisation.md RM-01/RM-02/RM-03,
// UC-014, UC-022. La distinction sensible/non-sensible n'est jamais laissee
// a la discretion d'un modele de langage : elle vient de Script.isSensitive,
// modifiable uniquement par un Administrateur.
model Script {
  id          String         @id @default(uuid())
  name        String
  language    ScriptLanguage
  content     String
  isSensitive Boolean        @default(true) @map("is_sensitive")
  createdAt   DateTime       @default(now()) @map("created_at")

  automationRuns  AutomationRun[]
  autoResolutions AutoResolution[]

  @@map("scripts")
}

enum ScriptLanguage {
  POWERSHELL
  CMD
  BASH
  PYTHON
}

model AutomationRun {
  id            String              @id @default(uuid())
  scriptId      String              @map("script_id")
  script        Script              @relation(fields: [scriptId], references: [id])
  ticketId      String?             @map("ticket_id")
  ticket        Ticket?             @relation(fields: [ticketId], references: [id])
  ciId          String?             @map("ci_id")
  ci            ConfigurationItem?  @relation(fields: [ciId], references: [id])
  requestedById String              @map("requested_by_id")
  requestedBy   User                @relation("AutomationRunsRequested", fields: [requestedById], references: [id])
  // NULL si l'execution a ete automatique (script non sensible, aucune
  // approbation humaine) ; sinon l'identite de l'approbateur dont la
  // decision a declenche l'execution.
  executedById  String?             @map("executed_by_id")
  executedBy    User?               @relation("AutomationRunsExecuted", fields: [executedById], references: [id])
  justification String
  status        AutomationRunStatus @default(PENDING_APPROVAL)
  startedAt     DateTime?           @map("started_at")
  finishedAt    DateTime?           @map("finished_at")
  outputLog     String?             @map("output_log")
  createdAt     DateTime            @default(now()) @map("created_at")

  approval Approval?

  @@index([status, requestedById])
  @@map("automation_runs")
}

// REJECTED n'est pas dans la liste du doc 08 (pending_approval, running,
// success, failed) mais est necessaire pour representer l'issue terminale
// d'un rejet (UC-022, variante) sans quoi le run resterait indefiniment
// bloque a PENDING_APPROVAL.
enum AutomationRunStatus {
  PENDING_APPROVAL
  RUNNING
  SUCCESS
  FAILED
  REJECTED
}

model Approval {
  id              String         @id @default(uuid())
  automationRunId String         @unique @map("automation_run_id")
  automationRun   AutomationRun  @relation(fields: [automationRunId], references: [id])
  approvedById    String?        @map("approved_by")
  approvedBy      User?          @relation(fields: [approvedById], references: [id])
  status          ApprovalStatus @default(PENDING)
  decidedAt       DateTime?      @map("decided_at")
  createdAt       DateTime       @default(now()) @map("created_at")

  @@map("approvals")
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

// docs/10-architecture-rag.md §11 "Apprentissage continu", docs/09
// §3.4/§10 (Agent Documentation), docs/11-documentation-api.md §7. Un
// resume genere par l'IA a la resolution d'un ticket n'entre dans la base
// de connaissances (recherche via /knowledge/search) qu'apres validation
// humaine explicite — jamais automatiquement, pour eviter de propager une
// solution incomplete ou erronee dans le systeme documentaire.
model KnowledgeArticle {
  id           String                 @id @default(uuid())
  // docs/06-cas-utilisation.md UC-015 : une resolution automatique (sans
  // ticket) genere aussi une proposition d'article — ticketId est donc
  // nullable, exactement un des deux (ticketId, autoResolutionId) est
  // renseigne selon l'origine.
  ticketId         String?          @map("ticket_id")
  ticket           Ticket?          @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  autoResolutionId String?          @unique @map("auto_resolution_id")
  autoResolution   AutoResolution?  @relation(fields: [autoResolutionId], references: [id], onDelete: Cascade)
  title        String
  content      String
  status       KnowledgeArticleStatus @default(PROPOSED)
  approvedById String?                @map("approved_by_id")
  approvedBy   User?                  @relation(fields: [approvedById], references: [id])
  decidedAt    DateTime?              @map("decided_at")
  createdAt    DateTime               @default(now()) @map("created_at")

  @@map("knowledge_articles")
}

enum KnowledgeArticleStatus {
  PROPOSED
  APPROVED
  REJECTED
}

// docs/06-cas-utilisation.md UC-015 ("Résolution automatique"), RM-03 :
// l'Agent IA résout un incident non sensible (confiance >= 95%, script non
// sensible) sans jamais créer de ticket dans le cas nominal. scriptId
// reste toujours valide (jamais supprimé) — la vérification RM-03 refaite
// à la confirmation (script encore non sensible ?) est ce qui peut faire
// basculer en FAILED_FALLBACK, avec un ticket standard créé pour porter le
// contexte de la tentative (fallbackTicketId).
model AutoResolution {
  id              String               @id @default(uuid())
  employeeId      String               @map("employee_id")
  employee        User                 @relation(fields: [employeeId], references: [id])
  description     String
  scriptId        String               @map("script_id")
  script          Script               @relation(fields: [scriptId], references: [id])
  confidenceScore Decimal              @map("confidence_score") @db.Decimal(4, 3)
  status          AutoResolutionStatus @default(RESOLVED)
  outputLog       String?              @map("output_log")
  fallbackTicketId String?             @unique @map("fallback_ticket_id")
  fallbackTicket   Ticket?             @relation(fields: [fallbackTicketId], references: [id])
  createdAt       DateTime             @default(now()) @map("created_at")

  knowledgeArticle KnowledgeArticle?

  @@map("auto_resolutions")
}

enum AutoResolutionStatus {
  RESOLVED
  FAILED_FALLBACK
}

// docs/11-documentation-api.md §6 (GET/PATCH /ai/agents), docs/08 §4.4 :
// registre des agents IA nommés, activables/désactivables par un Admin
// sans redéploiement. Seuls DIAGNOSTIC/DOCUMENTATION/AUTOMATION appellent
// réellement un LLM aujourd'hui (voir AiService) — SUPERVISOR et INVENTORY
// désignent des fonctionnalités déjà livrées (US-27, CMDB) qui sont
// purement analytiques/en lecture seule (docs/09 §3.6/§3.7) et HELPDESK
// n'a pas encore d'implémentation dédiée ; ces trois sont listés pour que
// le registre corresponde à docs/08 mais leur bascule n'a pas d'effet.
model AiAgent {
  id          String      @id @default(uuid())
  name        AiAgentName @unique
  description String
  isActive    Boolean     @default(true) @map("is_active")
  createdAt   DateTime    @default(now()) @map("created_at")

  messages AiMessage[]

  @@map("ai_agents")
}

enum AiAgentName {
  DIAGNOSTIC
  DOCUMENTATION
  AUTOMATION
  SUPERVISOR
  INVENTORY
  HELPDESK
}

// docs/11-documentation-api.md §6 (GET /ai/providers, PATCH
// /ai/providers/active) : un seul fournisseur actif à la fois. Seul CLAUDE
// a une intégration réelle (AiService) ; basculer vers OPENAI/AZURE_OPENAI
// force le mode dégradé (RM-05) plutôt que d'échouer, faute d'implémentation.
model AiProviderConfig {
  id        String          @id @default(uuid())
  provider  AiProviderName  @unique
  isActive  Boolean         @default(false) @map("is_active")
  createdAt DateTime        @default(now()) @map("created_at")

  @@map("ai_provider_configs")
}

enum AiProviderName {
  CLAUDE
  OPENAI
  AZURE_OPENAI
}

// docs/11-documentation-api.md §5 (POST /diagnostics, GET
// /diagnostics/:conversationId, POST /diagnostics/:conversationId/feedback)
// et §6 (GET /ai/conversations/:id/cost), docs/08 §4.4 : historique d'une
// conversation de diagnostic (Agent Diagnostic uniquement pour l'instant),
// avec le coût IA (tokens) par message pour permettre le suivi de coût.
model AiConversation {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  user      User      @relation(fields: [userId], references: [id])
  ticketId  String?   @map("ticket_id")
  ticket    Ticket?   @relation(fields: [ticketId], references: [id])
  provider  String
  model     String
  startedAt DateTime  @default(now()) @map("started_at")

  messages AiMessage[]

  @@map("ai_conversations")
}

model AiMessage {
  id              String        @id @default(uuid())
  conversationId  String        @map("conversation_id")
  conversation    AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  agentId         String?       @map("agent_id")
  agent           AiAgent?      @relation(fields: [agentId], references: [id])
  role            AiMessageRole
  content         String
  // RM-03 : seuil de confiance (>= 0.95) — nullable car l'API Anthropic ne
  // renvoie pas nativement un score de confiance pour les appels tool-use
  // actuels ; le champ existe pour un futur agent qui en fournirait un.
  confidenceScore Decimal?      @map("confidence_score") @db.Decimal(4, 3)
  responseTimeMs  Int?          @map("response_time_ms")
  tokenCost       Decimal?      @map("token_cost") @db.Decimal(10, 6)
  createdAt       DateTime      @default(now()) @map("created_at")

  feedback AiFeedback[]

  @@map("ai_messages")
}

enum AiMessageRole {
  USER
  AGENT
}

model AiFeedback {
  id           String    @id @default(uuid())
  messageId    String    @map("message_id")
  message      AiMessage @relation(fields: [messageId], references: [id])
  technicianId String    @map("technician_id")
  technician   User      @relation(fields: [technicianId], references: [id])
  wasHelpful   Boolean   @map("was_helpful")
  comment      String?
  createdAt    DateTime  @default(now()) @map("created_at")

  @@map("ai_feedback")
}

// docs/10-architecture-rag.md §3-8 (pipeline d'ingestion/recherche) et §13
// ("RAG multi-niveaux") : un document telecharge (procedure interne, manuel
// constructeur, note personnelle...) decoupe en chunks embeddes. Pas
// d'extension pgvector disponible sur cette instance Postgres locale (Windows,
// binaire tiers non installe) : l'embedding est stocke en Float[] simple et
// la similarite cosinus calculee cote application (voir knowledge/rag/*) —
// suffisant au volume attendu (le document lui-meme note que pgvector est une
// option a reevaluer, pas a anticiper prematurement, §7).
model KnowledgeDocument {
  id              String   @id @default(uuid())
  title           String
  content         String
  // 1=public/constructeur, 2=interne, 3=tickets resolus, 4=automatisation,
  // 5=personnel (doc 10 §13). Seuls les niveaux 1/2/4 sont creables via cet
  // endpoint pour un Admin, et le niveau 5 pour un Technicien (doc 11 §7) —
  // les niveaux 2/3/4 sont aussi alimentes automatiquement (voir
  // KnowledgeService.indexResolvedTicket/indexApprovedArticle/indexScript).
  knowledgeLevel  Int      @map("knowledge_level")
  ownerId         String?  @map("owner_id")
  owner           User?    @relation("KnowledgeDocumentOwner", fields: [ownerId], references: [id])
  uploadedById    String   @map("uploaded_by_id")
  uploadedBy      User     @relation("KnowledgeDocumentUploader", fields: [uploadedById], references: [id])
  authorName      String?  @map("author_name")
  sourceVersion   String?  @map("source_version")
  language        String   @default("fr")
  confidenceScore Decimal? @map("confidence_score") @db.Decimal(3, 2)
  createdAt       DateTime @default(now()) @map("created_at")

  chunks DocumentChunk[]

  @@map("knowledge_documents")
}

// Unite de recherche unifiee pour les 5 niveaux du RAG (doc 10 §13) : les
// documents televerses (documentId), mais aussi les tickets resolus
// (ticketId), les articles de connaissance approuves (knowledgeArticleId) et
// les scripts d'automatisation (scriptId) sont indexes ici au meme format,
// pour que KnowledgeService.search() applique un seul pipeline de recherche
// (embedding + filtrage par niveau/proprietaire + reranking, doc §8) quelle
// que soit l'origine du contenu. knowledgeLevel/ownerId sont denormalises
// depuis la source pour filtrer sans jointure a l'etape de recherche (doc
// §10 : le filtrage par droits d'acces doit se faire "avant", pas "en
// post-traitement").
model DocumentChunk {
  id                 String             @id @default(uuid())
  documentId         String?            @map("document_id")
  document           KnowledgeDocument? @relation(fields: [documentId], references: [id], onDelete: Cascade)
  ticketId           String?            @map("ticket_id")
  knowledgeArticleId String?            @map("knowledge_article_id")
  scriptId           String?            @map("script_id")
  knowledgeLevel     Int                @map("knowledge_level")
  ownerId            String?            @map("owner_id")
  sourceLabel        String             @map("source_label")
  content            String
  position           Int                @default(0)
  embedding          Float[]
  createdAt          DateTime           @default(now()) @map("created_at")

  @@index([knowledgeLevel])
  @@index([ownerId])
  @@map("document_chunks")
}
