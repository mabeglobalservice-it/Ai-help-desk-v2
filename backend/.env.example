# Prisma supports the native connection string format for PostgreSQL.
# See the documentation for all the connection string options: https://pris.ly/d/connection-strings
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ai_help_desk?schema=public"

# Generate a strong secret for local dev, e.g.: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="replace-with-a-strong-random-secret"
JWT_EXPIRES_IN="1h"
REFRESH_TOKEN_EXPIRES_IN_DAYS="30"

# Origin allowed to call the API from the browser (the Next.js frontend)
FRONTEND_URL="http://localhost:3002"

# API key from https://resend.com/api-keys, used to email users on notification events
RESEND_API_KEY="re_your_api_key"

# API key from https://console.anthropic.com/settings/keys, used for AI ticket diagnosis.
# Tests never call the real API with this key (see the "Tests" section of the
# root README) — only `npm run test:integration:live` does, on purpose.
ANTHROPIC_API_KEY="sk-ant-your-api-key"

# API key from https://dashboard.voyageai.com/api-keys, used for RAG embeddings
# (base de connaissances/recherche, docs/10-architecture-rag.md §6). Optional:
# if absent (or if a call fails), embed() falls back automatically to a local,
# free, deterministic vectorizer (RM-05) — see src/knowledge/rag/embedding.util.ts.
# Tests never call the real API with this key, same as ANTHROPIC_API_KEY above.
VOYAGE_API_KEY="pa-your-api-key"

# Redis, used by the BullMQ queue "notifications-delivery" (email + Teams/
# Slack webhooks) so those slow, external-service calls don't block the
# request that triggered the notification (see
# src/notifications-delivery/). Optional: if Redis is unreachable, the
# backend falls back automatically to sending notifications synchronously
# (RM-05, same spirit as ANTHROPIC_API_KEY/VOYAGE_API_KEY above) — no crash,
# just no async decoupling. `docker compose up` starts a local Redis on this
# default.
REDIS_URL="redis://localhost:6379"

# Incoming Webhook URLs (docs/02-brd.md BR-12) — every notification is also
# posted to these channels, in addition to email. Optional: omit to disable.
# Teams: channel > Connectors > Incoming Webhook (or a Workflow "Post to a channel" URL)
TEAMS_WEBHOOK_URL=""
# Slack: https://api.slack.com/messaging/webhooks
SLACK_WEBHOOK_URL=""
